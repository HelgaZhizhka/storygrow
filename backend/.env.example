# Backend environment — copy to .env and fill in. NEVER commit the real .env.
# Values here are placeholders/examples only.

# --- Database ---
DATABASE_URL=postgresql://storygrow:storygrow@localhost:5432/storygrow
POSTGRES_USER=storygrow
POSTGRES_PASSWORD=storygrow
POSTGRES_DB=storygrow

# --- Queue / cache ---
REDIS_URL=redis://localhost:6379

# --- LLM (text) ---
OPENAI_API_KEY=sk-...

# --- Image generation ---
# Provider: 'gemini' (default) | 'openai' fallback.
# Image provider — 'xai' (Grok Imagine 2.0, chosen default: best geometry/quality, ADR-0007)
# | 'gemini' fallback | 'openai' legacy. Portrait-as-reference on every page; no cascade.
IMAGE_PROVIDER=xai
# Visual Bible reference sheets (#348): 'on' generates per-location and per-cast
# reference images to anchor environment/secondary characters. Default 'off' until
# the eval:images comparison picks a variant (ADR-0007).
IMAGE_REFERENCE_SHEETS=on
# Gemini key from Google AI Studio (NOT the OAuth GOOGLE_CLIENT_* below).
XAI_API_KEY=                          # xAI Grok image API (IMAGE_PROVIDER=xai)
GOOGLE_GENERATIVE_AI_API_KEY=...
# Gemini image model. Default gemini-2.5-flash-image (Nano Banana).
# Set gemini-3-pro-image (Nano Banana Pro, ~3.4x cost) for higher likeness (#128).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Observability (LangFuse, self-hosted) ---
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_SALT=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me
# Set to 'false' to disable AI telemetry locally.
# LANGFUSE_ENABLED=true

# --- Storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_BUCKET=storygrow

# --- Auth (Google OAuth + JWT) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
JWT_SECRET=...
JWT_REFRESH_SECRET=...
FRONTEND_URL=http://localhost:3000

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# --- Eval thresholds ---
EVAL_THRESHOLD=7.0
EVAL_MAX_RETRIES=2

# --- E2E test-login (#301) — leave BOTH unset in production ---
# /auth/test-login opens only when E2E_TEST_MODE=true AND the request's
# x-e2e-secret header equals E2E_TEST_SECRET (which must be non-empty). Two
# independent factors, no NODE_ENV inference. Set only in CI/e2e (verify.sh).
# E2E_TEST_MODE=true
# E2E_TEST_SECRET=some-long-random-value

# --- Qwen bake-off spike only (#128) — NOT used by the app; rejected for prod ---
# DASHSCOPE_API_KEY=sk-...
# QWEN_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
