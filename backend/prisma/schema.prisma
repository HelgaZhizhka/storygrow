// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
  // Emit .js import specifiers + CJS so the compiled client (dist/) resolves at
  // runtime under `node dist/main`. A fresh generate otherwise emits .ts
  // specifiers that survive compilation and crash in production (issue #208).
  importFileExtension = "js"
  moduleFormat        = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Auth ──────────────────────────────────────────────────────────────────

enum UserRole {
  user
  admin
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  googleId            String?       @unique
  refreshToken        String?
  role                UserRole      @default(user)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  children            Child[]
  books               Book[]
  subscription        Subscription?
  customLearningGoals LearningGoal[]
}

// ─── Child ─────────────────────────────────────────────────────────────────

model Child {
  id         String   @id @default(cuid())
  name       String
  age        Int
  gender     String?
  appearance String?
  interests  String[]
  userId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books     Book[]

  @@unique([userId, name])
}

// ─── Books ─────────────────────────────────────────────────────────────────

model Book {
  id             String       @id @default(cuid())
  title          String
  status         BookStatus   @default(pending)
  storyJson      Json?
  imageKeys             String[]     @default([])
  characterPortraitKey  String?
  // S3 keys of generated Visual Bible reference sheets (#348, PR 2): location
  // establishing shots and cast portraits. Empty unless IMAGE_REFERENCE_SHEETS=on.
  referenceImageKeys    String[]     @default([])
  pdfKey                String?
  // Photo-character likeness (#128, child mode). childPhotoKey is the TRANSIENT
  // private S3 key of the raw upload — nulled the moment the stylised portrait is
  // persisted (raw child photo lives exactly once; see spec decision 5).
  // characterDescriptor is the editable feature line extracted from the photo;
  // photoConsent gates generation on explicit parental consent.
  childPhotoKey         String?
  characterDescriptor   String?
  photoConsent          Boolean      @default(false)
  protagonistMode ProtagonistMode @default(child)
  artStyle        ArtStyle        @default(watercolor)
  // Personalization seeds (#197) — soft, per-book material fed into the Plan
  // phase to attack banality with concrete detail. They flavour the hero's world
  // (props, setting, small touches); they never change premise, conflict, or
  // lesson. favoriteWords are woven only where natural, never forced.
  // (A `belongings` seed was tried and removed — #245: it needed a firm
  // presence guarantee per exemplar, an ongoing whack-a-mole risk.)
  interests       String[]        @default([])
  motifs          String[]        @default([])
  favoriteWords   String[]        @default([])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId        String
  child          Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  learningGoalId String
  learningGoal   LearningGoal @relation(fields: [learningGoalId], references: [id])
  pages          BookPage[]
  evals          StoryEval[]
  imageEvals     ImageEval[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum BookStatus {
  pending
  generating
  ready
  failed
  images_failed
}

enum ProtagonistMode {
  child
  observer
}

enum ArtStyle {
  watercolor
  cartoon
  storybook
  pixel
  realistic
}

model BookPage {
  id         String  @id @default(cuid())
  bookId     String
  book       Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  text       String
  imageUrl   String?
}

// ─── Evaluation ────────────────────────────────────────────────────────────

// One vision-judge verdict per rendered page per attempt (#358) — the image
// counterpart of StoryEval. `scores` is the boolean criteria object
// (ImageJudgeSchema), `failures` the failed gates; never silent: a row exists
// for every attempt, including the ones the book shipped with.
model ImageEval {
  id         String   @id @default(cuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  attempt    Int      @default(1)
  scores     Json
  passed     Boolean  @default(false)
  failures   String[] @default([])
  reasoning  String?
  judgedAt   DateTime @default(now())

  @@index([bookId])
}

model StoryEval {
  id                   String   @id @default(cuid())
  bookId               String
  book                 Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  judgeScores          Json
  judgeReasoning       String?
  finalScore           Float
  vocabularyCompliance Float?
  passed               Boolean  @default(false)
  attempt              Int      @default(1)
  generatedAt          DateTime @default(now())
}

// ─── Payments ──────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  stripeCustomerId     String?
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus
  periodEnd            DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

// ─── Catalogue ─────────────────────────────────────────────────────────────

enum LearningGoalArcType {
  virtue
  flaw
}

model LearningGoal {
  id              String              @id @default(cuid())
  title           String
  description     String
  arcType         LearningGoalArcType @default(virtue)
  ageRangeMin     Int                 @default(1)
  ageRangeMax     Int                 @default(18)
  createdAt       DateTime            @default(now())
  createdByUserId String?
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  books           Book[]
  templates       Template[]
}

// ─── RAG ───────────────────────────────────────────────────────────────────

model VocabularyEntry {
  id         String                       @id @default(cuid())
  word       String                       @unique
  gradeLevel Int
  frequency  Float
  embedding  Unsupported("vector(1536)")?
}

// ─── Fast Flow ─────────────────────────────────────────────────────────────

model Template {
  id               String       @id @default(cuid())
  title            String
  content          Json
  learningGoalId   String
  learningGoal     LearningGoal @relation(fields: [learningGoalId], references: [id])
  illustrationTags String[]
  createdAt        DateTime     @default(now())
}

model FastIllustration {
  id        String   @id @default(cuid())
  url       String
  tags      String[]
  createdAt DateTime @default(now())
}
